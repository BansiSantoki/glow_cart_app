<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- BACKGROUND GRADIENT -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:startColor="#1A1F4B"
                android:endColor="#4C60D3"
                android:type="linear"/>
        </shape>
    </item>

    <!-- FRAMED CARD STYLE + BUTTON TOO -->
    <item android:top="5dp" android:bottom="5dp">
        <shape android:shape="rectangle">
            <corners android:radius="25dp" />
            <stroke android:width="1dp" android:color="#80FFFFFF" />
            <solid android:color="#442C2C2C" />
        </shape>
    </item>

</layer-list>
