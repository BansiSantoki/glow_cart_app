<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Activity_combohaircare"
    android:background="#F8F8FF">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:elevation="6dp"
                android:background="#00897B">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="💚 Hair Care Combo Pack"
                    android:textColor="@android:color/white"
                    android:textSize="22sp"
                    android:textStyle="bold"/>

                <Button
                    android:id="@+id/btnLogout"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Logout"
                    android:textColor="@android:color/white"
                    android:backgroundTint="#004D40"
                    android:textSize="14sp"/>
            </LinearLayout>

            <!-- Combo 01 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:background="#FFFFFF">

                    <ImageView
                        android:id="@+id/hcimg1"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/haircare1"
                        android:layout_marginEnd="16dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:text="Hair Spa + Smooth Shampoo"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#333333"/>

                        <TextView
                            android:text="Price: ₹899"
                            android:textColor="#00897B"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:layout_marginBottom="10dp"/>

                        <LinearLayout android:orientation="horizontal">
                            <TextView
                                android:text="Qty:"
                                android:textSize="16sp"
                                android:textColor="#666666"
                                android:layout_marginEnd="10dp"/>

                            <EditText
                                android:id="@+id/hcqty1"
                                android:layout_width="60dp"
                                android:layout_height="40dp"
                                android:text="0"
                                android:gravity="center"
                                android:inputType="number"/>
                        </LinearLayout>

                        <Button
                            android:id="@+id/hcadd1"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="Add to Cart"
                            android:textColor="@android:color/white"
                            android:backgroundTint="#00897B"
                            android:layout_marginTop="10dp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Combo 02 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:background="#FFFFFF">

                    <ImageView
                        android:id="@+id/hcimg2"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/haircare2"
                        android:layout_marginEnd="16dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:text="Keratin Serum + Hair Mask"
                            android:textStyle="bold"
                            android:textSize="18sp"
                            android:textColor="#333333"/>

                        <TextView
                            android:text="Price: ₹1099"
                            android:textColor="#00897B"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:layout_marginBottom="10dp"/>

                        <LinearLayout android:orientation="horizontal">
                            <TextView
                                android:text="Qty:"
                                android:textSize="16sp"
                                android:textColor="#666666"
                                android:layout_marginEnd="10dp"/>

                            <EditText
                                android:id="@+id/hcqty2"
                                android:layout_width="60dp"
                                android:layout_height="40dp"
                                android:text="0"
                                android:gravity="center"
                                android:inputType="number"/>
                        </LinearLayout>

                        <Button
                            android:id="@+id/hcadd2"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="Add to Cart"
                            android:textColor="@android:color/white"
                            android:backgroundTint="#00897B"
                            android:layout_marginTop="10dp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- CART BUTTON -->
            <Button
                android:id="@+id/hccart"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="🛒 Proceed to Cart"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:backgroundTint="#004D40"
                android:layout_margin="18dp"/>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
